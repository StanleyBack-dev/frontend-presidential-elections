{
  "name": "frontend-presidential-elections",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:server",
    "dev:lan": "npm-run-all --parallel dev:web:lan dev:server",
    "dev:web": "vite",
    "dev:web:lan": "vite --host 0.0.0.0",
    "dev:server": "nodemon --watch server/src server/src/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "format-and-lint": "prettier --write . && npm run lint",
    "prepush:check": "npx prettier --write . && npm run lint -- --max-warnings 0",
    "prepare": "husky",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.15.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
