# Copie para .env.local (não versionado).
# Chave pública do Cloudflare Turnstile. Vazio desativa o captcha localmente.
# Chave de teste que sempre passa: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Domínio público do site, usado nas prévias de link (WhatsApp, Telegram, Facebook, X).
# Opcional na Vercel: sem ele, o build usa o domínio de produção que a Vercel informa.
VITE_SITE_URL=
