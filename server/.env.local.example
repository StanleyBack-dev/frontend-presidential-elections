# Configuração local do BFF. Copie para server/.env.local
# Em produção, configure as mesmas variáveis no projeto do frontend na Vercel.

BFF_PORT=5000
BACKEND_GRAPHQL_URL=http://localhost:4000/graphql

# Mesmo valor de INTERNAL_API_SECRET do backend (>= 32 caracteres).
INTERNAL_API_SECRET=dev-internal-api-secret-change-me-presidential-2026

# Rate limit por IP (janela em segundos / máximo de requisições)
BFF_RATE_LIMIT_WINDOW_SECONDS=60
BFF_RATE_LIMIT_MAX=120
BFF_VOTE_RATE_LIMIT_WINDOW_SECONDS=600
BFF_VOTE_RATE_LIMIT_MAX=10

BFF_OBSERVABILITY_LOGS_ENABLED=true
